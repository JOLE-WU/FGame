{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client", "react", "react-dom", "node"],
    "rootDir": "..",
    "tsBuildInfoFile": "./.tsbuildinfo.client",
    "paths": {
      "@space/server/*": ["../server/src/*"]
    }
  },
  "include": ["src/**/*", "vite.config.ts", "../server/src/**/*"]
}
