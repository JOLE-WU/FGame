# ── FGame 配置样例（复制为 .env 或作为环境变量传入）──

# 前端：后端 API 地址。留空 = 同源（本地开发）。
# 打包 iOS App 前必须设为已部署的后端地址，例如 https://fgame-api.example.com
VITE_API_BASE=

# 本地开发时把 /actions 代理到后端（可选）
VITE_DEV_API=http://localhost:8787

# ── 后端 server ──
PORT=8787
# SQLite 数据库文件路径
FGAME_DB=./fgame.db
# 头像等 blob 存储目录
FGAME_BLOBS_DIR=./blobs
# drizzle 迁移目录
FGAME_DRIZZLE_DIR=./drizzle
# 静态托管前端构建产物（可选；不设则仅提供 API）
FGAME_WEB_DIR=./client/dist
# blob 生成 URL 时使用的对外 origin
FGAME_PUBLIC_ORIGIN=http://localhost:8787
# 每日自动刷新（原 Space 的定时任务）
FGAME_AUTO_REFRESH=0
FGAME_REFRESH_MS=21600000

# ── iOS 打包（GitHub Actions / 本地 prepare-ios.mjs）──
FGAME_BUNDLE_ID=com.fgame.daily
FGAME_VERSION=1.0.0
# DEVELOPMENT_TEAM=YOURTEAMID
# EXPORT_METHOD=development
# PROVISIONING_PROFILE_UUID=xxxxxxxx
